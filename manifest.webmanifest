{
  "name": "Comfyair Job Sheets",
  "short_name": "Comfyair",
  "description": "Service sheets, commissioning, multi-unit reports and RAMS, signed on site and sent as PDF.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#004684",
  "theme_color": "#004684",
  "lang": "en-GB",
  "categories": ["business", "productivity"],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "title": "title", "text": "text", "files": [{ "name": "file", "accept": ["application/pdf", ".pdf", "application/json", ".json", "application/octet-stream", "text/plain"] }] }
  },
  "icons": [
    { "src": "assets/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "assets/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
